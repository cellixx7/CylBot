{
  "name": "cylbot",
  "version": "1.0.0",
  "description": "Bot modular para Discord com discord.js",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "smoke": "node --test test/smoke.test.js",
