# Obrigatórias para iniciar o bot e registrar comandos.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Desenvolvimento por padrão. Em produção, permite somente WEB_ORIGIN exata.
NODE_ENV=development

# Tickets: ative Message Content Intent no Discord Developer Portal antes de habilitar.
# true adiciona os intents de mensagens ao conectar; reinicie o bot após mudar.
TICKETS_MESSAGE_CONTENT_ENABLED=false

# Opcional: inteiro de 1 a 65535. Default: 3001.
API_PORT=3001

# OpenRouter é opcional; a chave é necessária apenas para geração com IA.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Inteiro positivo; default 800, valores maiores são limitados a 800.
OPENROUTER_MAX_TOKENS=800

# Spotify é opcional. Presence requer as quatro credenciais/playlist abaixo.
# O auxiliar spotify:auth exige apenas Client ID e Client Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=
# Deve coincidir com a URL cadastrada no Spotify; HTTP(S), sem credenciais/fragmento.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Opcional: executável usado pelo auxiliar para abrir o navegador. Default: xdg-open.
BROWSER=

# Nível mínimo de logging: debug, info, warn ou error.
LOG_LEVEL=info

# OAuth Web opcional: preencher o secret habilita o login; reutiliza DISCORD_CLIENT_ID.
DISCORD_OAUTH_CLIENT_SECRET=
# Codespaces detecta a origem atual automaticamente; local usa http://localhost:5173.
# WEB_ORIGIN e DISCORD_OAUTH_REDIRECT_URI explícitos sobrescrevem a detecção.
# O callback deve permanecer na mesma origem, em /api/auth/discord/callback.
CODESPACES=
CODESPACE_NAME=
GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=app.github.dev
WEB_ORIGIN=
DISCORD_OAUTH_REDIRECT_URI=
# Sessão absoluta: 8 horas por padrão, máximo 30 dias. HTTPS ativa cookie Secure.
SESSION_TTL_SECONDS=28800
